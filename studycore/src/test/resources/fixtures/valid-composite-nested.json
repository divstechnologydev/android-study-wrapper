{
  "schemaVersion": 1,
  "study": {
    "id": "st_comp_nested",
    "name": "Composite target fixture",
    "status": "active"
  },
  "tracking": {
    "token": "MOVEO_PROJECT_TOKEN_EXAMPLE",
    "apiUrl": "https://api.moveo.one/api/analytic/event/tag",
    "origins": [
      "sainsburys.co.uk"
    ],
    "deploymentType": "STATIC_WEBSITE",
    "appVersion": "1.0.0",
    "storageSource": "local",
    "userDataKeys": [],
    "excludeDetailedTracking": false
  },
  "flow": {
    "leadInUrl": "https://forms.example.com/intro",
    "leadOutUrl": "https://forms.example.com/exit",
    "targetAction": {
      "type": "and",
      "conditions": [
        {
          "type": "url_match",
          "pattern": "/checkout/*/success"
        },
        {
          "type": "or",
          "conditions": [
            {
              "type": "event_match",
              "props": {
                "eA": "click",
                "eT": "button",
                "eV": "Buy now"
              }
            },
            {
              "type": "event_match",
              "props": {
                "eA": "click",
                "eT": "button",
                "eV": "Pay now"
              }
            }
          ]
        }
      ]
    },
    "appendParticipantId": true
  }
}
