<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG builds only (§a2.7): cleartext allowed exclusively for the local
     mock backend — localhost and the emulator→host loopback 10.0.2.2.
     Release builds have no network security config: platform default,
     cleartext blocked everywhere. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
