<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Config fetch + enroll + the study WebView. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility (API 30+): resolve browsers / Custom Tabs
         providers for lead surveys and externalized links (§a2.5–a2.6). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyWrapper"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!-- Single activity, portrait-locked v1 (docs/plan.md §a0.6). Setup
             links (§a1) arrive through the two VIEW filters below and land
             in MainActivity.handleIntent → AppViewModel.handleOpenUrl. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- a1.1 App Link:
                 https://app.moveo.one/extension/config/<code>[?transaction_id=…]
                 Opens the app directly once the platform publishes
                 https://app.moveo.one/.well-known/assetlinks.json listing this
                 package (§h4: BOTH the Play App Signing and the AppGallery
                 distribution fingerprints). Where verification is absent
                 (assetlinks not yet live, GMS-less devices below Android 12)
                 the link opens the browser → landing page → the scheme link
                 below. Same filter for both store flavors. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="app.moveo.one" />
                <data android:pathPrefix="/extension/config/" />
            </intent-filter>

            <!-- a1.2 Custom scheme: moveoone://config/<code>[?transaction_id=…]
                 — the landing page's "Open in app" button, QA scripts, mail
                 clients that wrap https links. Kept as a SEPARATE filter:
                 autoVerify must never cover a custom scheme. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="moveoone" />
                <data android:host="config" />
            </intent-filter>
        </activity>
    </application>
</manifest>
